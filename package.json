{
  "name": "beacon-watch",
  "private": true,
  "description": "Uptime and latency monitoring with incident timelines, cached status pages, and a rate-limited public API.",
  "license": "MIT",
  "author": "Christian Agila",
  "type": "module",
  "packageManager": "pnpm@10.33.3",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint .",
    "test": "vitest run",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "api": "pnpm --filter @beacon-watch/api dev",
    "worker": "pnpm --filter @beacon-watch/worker dev",
    "web": "pnpm --filter @beacon-watch/web dev",
    "compose:config": "docker compose --env-file .env.example config --quiet"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.4",
    "eslint": "^10.11.0",
    "globals": "^17.12.0",
    "prettier": "^3.9.9",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.1",
    "vitest": "^5.0.2"
  }
}

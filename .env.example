# Copy to .env for local overrides. Every value here is a non-secret local-dev placeholder.
# Real deployments inject values from a secret store; never commit a populated .env.

NODE_ENV=development
LOG_LEVEL=info

# --- Postgres (Compose service `db`) ---
POSTGRES_USER=beacon
POSTGRES_PASSWORD=beacon-local-only
POSTGRES_DB=beacon
DATABASE_URL=postgresql://beacon:beacon-local-only@db:5432/beacon

# --- Redis (Compose service `redis`) ---
REDIS_URL=redis://redis:6379

# --- API (Fastify) ---
API_PORT=4000
# Session signing key; must be >= 32 chars. Generate your own: openssl rand -base64 48
SESSION_SECRET=replace-me-with-at-least-32-random-characters
# Public status API limit per client IP (FR-PUB-004). Fails closed (503) if Redis is down.
PUBLIC_RATE_LIMIT_PER_MIN=60

# --- Web (Next.js) ---
WEB_PORT=3000
APP_BASE_URL=http://localhost:3000
API_BASE_URL=http://api:4000

# --- Worker / probes ---
# true blocks private, loopback, link-local, and metadata addresses (SRS Appendix C).
# Compose sets false so http://mock-target:8080 is reachable on the Docker network.
SSRF_PROTECTION=true
PROBE_MAX_CONCURRENCY=20
PROBE_MAX_PER_HOST=2

# --- mock-target ---
MOCK_TARGET_PORT=8080

# --- Demo seed (Appendix D). Local demo credential only. ---
DEMO_PASSWORD=demo-password-change-me
